PORT=4000
ALLOWED_ORIGINS=http://localhost:5173
# Required - the server refuses to start without this. Generate with: openssl rand -hex 32
JWT_SECRET=

# Postgres (with pgvector) + MinIO + Redis, started via `npm run docker:up` at the repo root.
DATABASE_URL=postgresql://amplify:amplify@localhost:5432/amplify_ai
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=documents
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=amplify
OBJECT_STORE_SECRET_KEY=amplify123

# BullMQ job queue (extract/OCR/index run in a separate worker process - see `npm run worker`).
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=amplify
# Per-queue worker concurrency. index=1 matches Ollama's effective serialization (parallel index
# jobs would just contend for the same Ollama instance); extract/ocr get modest parallelism since
# they don't contend with Ollama.
EXTRACT_QUEUE_CONCURRENCY=2
OCR_QUEUE_CONCURRENCY=2
INDEX_QUEUE_CONCURRENCY=1

# Rate limits (per IP, Redis-backed so they survive restarts). Login is strict for brute-force
# protection; the LLM/upload/rebuild limits protect against cost and resource abuse.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LLM_RATE_LIMIT_MAX=60
LLM_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
REBUILD_RATE_LIMIT_MAX=5
REBUILD_RATE_LIMIT_WINDOW_MS=900000

# Extraction bounds. Word/Excel files are zip archives that can inflate far beyond their upload
# size (zip bombs), and every extracted character costs embedding time - both are capped.
MAX_UNCOMPRESSED_BYTES=262144000
MAX_EXTRACTED_CHARS=20000000

# Self-hosted PaddleOCR service (see ocr_service/) for scanned image documents - replaces
# Tesseract, which scored 49% confidence with visibly garbled text on this app's own test invoice
# scan, against 99% clean text for PaddleOCR on the same file. Also closes a real privacy gap:
# Tesseract fetches its language data from a public CDN on first use; PaddleOCR's model weights
# are downloaded once during setup and every request after that is fully offline.
OCR_SERVICE_URL=http://localhost:8100

# Free, local, no key required - answer generation tries this first if Ollama is running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# Used for chunk/query embeddings (retrieval), separate from the chat model above.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional paid fallback, only used if Ollama is unavailable.
ANTHROPIC_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (RunPod vLLM, Groq, OpenRouter, Together,
# DeepInfra, Fireworks, ...) to A/B-test answer quality against the local/Anthropic providers
# above. Only active when both BASE_URL and MODEL are set - leave blank to leave behavior
# unchanged. Run `node scripts/eval-answers.js` after pointing this at a provider to get a real,
# comparable accuracy score (answerModel in the output will read "custom:<model>").
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
